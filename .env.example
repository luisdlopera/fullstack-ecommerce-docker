# =============================================================================
# NEXSTORE - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Port Configuration (5000+ range - consecutivos y consistentes)
# -----------------------------------------------------------------------------
FRONT_PORT=5000
BACK_PORT=5001
POSTGRES_PORT=5002
REDIS_PORT=5003
MINIO_PORT=5004
MINIO_CONSOLE_PORT=5005

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
PORT=5001
APP_ENV=development
ENABLE_SWAGGER=true

# -----------------------------------------------------------------------------
# URLs and CORS
# -----------------------------------------------------------------------------
# URL del frontend para CORS y redirecciones
FRONTEND_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5000
CORS_ORIGIN=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000

# URL publica del API (usada por el frontend browser-side)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# URL interna del API (usada por el frontend server-side en Docker)
INTERNAL_API_URL=http://back:5001/api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=nexstore
POSTGRES_PASSWORD=nexstore
POSTGRES_DB=nexstore
DATABASE_URL=postgresql://nexstore:nexstore@localhost:5002/nexstore?schema=public

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:5003

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 64
JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_MX_REQUIRED=true
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com,yopmail.com

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
# API Key de Resend - reemplazar con tu clave real
SMTP_PASS=your-resend-api-key
SMTP_FROM=onboarding@resend.dev
ADMIN_EMAIL=admin@nexstore.local
LOW_STOCK_ALERT_EMAIL=ops@nexstore.local

# -----------------------------------------------------------------------------
# Payment (MercadoPago)
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=your-mercadopago-access-token

# -----------------------------------------------------------------------------
# Commerce
# -----------------------------------------------------------------------------
TAX_RATE=0.15

# -----------------------------------------------------------------------------
# Storage (MinIO local / Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_BUCKET=nexstore-products
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:5004
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:5004/nexstore-products
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:5000
E2E_AUTH_REAL=

