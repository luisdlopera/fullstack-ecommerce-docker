# =============================================================================
# NEXSTORE - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real secrets to version control.
# =============================================================================
# Este archivo configura el entorno para Docker Compose.
# Los servicios usan nombres de host de Docker (postgres, redis, minio).
# =============================================================================

# -----------------------------------------------------------------------------
# Port Configuration (5000+ range - consecutivos y consistentes)
# -----------------------------------------------------------------------------
FRONTEND_PORT=5006
FRONT_PORT=5006
BACKEND_PORT=5007
BACK_PORT=5007
DATABASE_PORT=5008
POSTGRES_PORT=5008
REDIS_PORT=5009

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
PORT=5007
APP_ENV=development
ENABLE_SWAGGER=true

# -----------------------------------------------------------------------------
# Debug Logging (set to 'true' to enable auth debug logs)
# -----------------------------------------------------------------------------
AUTH_DEBUG_LOGS=false

# -----------------------------------------------------------------------------
# URLs and CORS
# -----------------------------------------------------------------------------
# URL del frontend para CORS y redirecciones
FRONTEND_URL=http://localhost:5006
FRONTEND_ORIGIN=http://localhost:5006
CORS_ORIGIN=http://localhost:5006
CORS_ALLOWED_ORIGINS=http://localhost:5006

# URL publica del API (usada por el frontend browser-side)
NEXT_PUBLIC_API_URL=http://localhost:5007/api

# URL interna del API (usada por el frontend server-side en Docker)
INTERNAL_API_URL=http://back:5007/api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=nexstore
POSTGRES_PASSWORD=nexstore
POSTGRES_DB=nexstore
# Para Docker, usar el hostname del servicio
# Para desarrollo local sin Docker, usar: postgresql://nexstore:nexstore@127.0.0.1:5008/nexstore?schema=public
DATABASE_URL=postgresql://nexstore:nexstore@postgres:5432/nexstore?schema=public

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
# Para Docker, usar el hostname del servicio
# Para desarrollo local sin Docker, usar: redis://localhost:5009
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generar con: openssl rand -hex 64
JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_MX_REQUIRED=true
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com,yopmail.com

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
# API Key de Resend - reemplazar con tu clave real
SMTP_PASS=your-resend-api-key
SMTP_FROM=onboarding@resend.dev
ADMIN_EMAIL=admin@nexstore.local
LOW_STOCK_ALERT_EMAIL=ops@nexstore.local

# -----------------------------------------------------------------------------
# Payment (MercadoPago)
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=your-mercadopago-access-token

# -----------------------------------------------------------------------------
# Commerce
# -----------------------------------------------------------------------------
TAX_RATE=0.15

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=nexstore
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=<r2-access-key>
STORAGE_SECRET_KEY=<r2-secret-key>
# Usar el dominio r2.dev para STORAGE_PUBLIC_URL (no el endpoint S3)
STORAGE_PUBLIC_URL=https://<your-r2-dev-domain>.r2.dev
STORAGE_FORCE_PATH_STYLE=false
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:5006
E2E_AUTH_REAL=

