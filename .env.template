# Infrastructure (Docker Compose)
POSTGRES_USER=nexstore
POSTGRES_PASSWORD=nexstore
POSTGRES_DB=nexstore
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend runtime
DATABASE_URL=postgresql://nexstore:nexstore@localhost:5432/nexstore?schema=public
REDIS_URL=redis://localhost:6379
ENABLE_SWAGGER=false

# Auth and security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_MX_REQUIRED=true
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com,yopmail.com

# Email (local defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nexstore.local

# Commerce
TAX_RATE=0.15
LOW_STOCK_ALERT_EMAIL=ops@nexstore.local

# Payments
MP_ACCESS_TOKEN=replace-with-mercadopago-access-token

# Storage (MinIO local)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=nexstore-products
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/nexstore-products
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_BYTES=5242880
