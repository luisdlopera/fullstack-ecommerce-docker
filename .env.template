# Docker compose shared environment
POSTGRES_USER=nexstore
POSTGRES_PASSWORD=nexstore
POSTGRES_DB=nexstore
POSTGRES_PORT=5432

# Public URL used by the browser (front -> back)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_ORIGIN=http://localhost:3000

# Optional local backend connection string when running without Docker
DATABASE_URL=postgresql://nexstore:nexstore@localhost:5432/nexstore?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret #openssl rand -hex 64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENABLE_SWAGGER=false

# Checkout
TAX_RATE=0.15

# Mercado Pago
MP_ACCESS_TOKEN=replace-with-mercadopago-access-token

# Storage (MinIO local / Cloudflare R2 demo-prod)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=nexstore-products
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/nexstore-products
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# MinIO local ports
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
