# =============================================================================
# NEXSTORE BACKEND - Environment Configuration
# =============================================================================
# NEVER commit .env files with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Port Configuration (5000+ range)
# -----------------------------------------------------------------------------
PORT=5007
BACKEND_PORT=5007
DATABASE_PORT=5008
REDIS_PORT=5009
# Legacy aliases (for backwards compatibility)
BACK_PORT=5007
POSTGRES_PORT=5008

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
APP_ENV=development
ENABLE_SWAGGER=true

# -----------------------------------------------------------------------------
# URLs and CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5006
FRONTEND_ORIGIN=http://localhost:5006
CORS_ORIGIN=http://localhost:5006
CORS_ALLOWED_ORIGINS=http://localhost:5006
NEXT_PUBLIC_API_URL=http://localhost:5007/api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=nexstore
POSTGRES_PASSWORD=nexstore
POSTGRES_DB=nexstore
DATABASE_URL=postgresql://nexstore:nexstore@127.0.0.1:5008/nexstore?schema=public

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:5009

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_MX_REQUIRED=true
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com,yopmail.com

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
AUTH_DEBUG_LOGS=false
SMTP_USER=resend
# Reemplazar con tu API key real de Resend para enviar emails
SMTP_PASS=your-resend-api-key
SMTP_FROM=onboarding@resend.dev
ADMIN_EMAIL=admin@nexstore.local
LOW_STOCK_ALERT_EMAIL=ops@nexstore.local

# -----------------------------------------------------------------------------
# Payment (MercadoPago)
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=replace-with-mercadopago-access-token

# -----------------------------------------------------------------------------
# Commerce
# -----------------------------------------------------------------------------
TAX_RATE=0.15

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=nexstore
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=<r2-access-key>
STORAGE_SECRET_KEY=<r2-secret-key>
# Usar el dominio r2.dev para STORAGE_PUBLIC_URL (no el endpoint S3)
STORAGE_PUBLIC_URL=https://<your-r2-dev-domain>.r2.dev
STORAGE_FORCE_PATH_STYLE=false
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# =============================================================================
# Rate Limiting Advanced Configuration
# =============================================================================
# Enable/disable rate limiting globally
RATE_LIMIT_ENABLED=true

# Storage type: 'memory' (single-instance) | 'redis' (distributed, recommended for prod)
RATE_LIMIT_STORAGE=memory

# Redis URL for rate limiting (uses REDIS_URL if not set)
# RATE_LIMIT_REDIS_URL=redis://localhost:5009

# Trust proxy headers for real IP detection (enable in production with reverse proxy)
TRUST_PROXY_ENABLED=false

# Global rate limit (applies to all requests by IP)
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=100

# Auth endpoints (login, register, etc) - strict limits
RATE_LIMIT_AUTH_TTL=300
RATE_LIMIT_AUTH_LIMIT=5

# Refresh token endpoint
RATE_LIMIT_REFRESH_TTL=60
RATE_LIMIT_REFRESH_LIMIT=10

# Public endpoints (webhooks, etc)
RATE_LIMIT_PUBLIC_TTL=60
RATE_LIMIT_PUBLIC_LIMIT=60

# Admin endpoints
RATE_LIMIT_ADMIN_TTL=60
RATE_LIMIT_ADMIN_LIMIT=200

# Authenticated users (separate limit, more generous)
RATE_LIMIT_AUTH_USER_TTL=60
RATE_LIMIT_AUTH_USER_LIMIT=200

# Exclude health checks and metrics from rate limiting
RATE_LIMIT_EXCLUDE_HEALTH=true
RATE_LIMIT_EXCLUDE_METRICS=true

# Include rate limit headers in responses
RATE_LIMIT_INCLUDE_HEADERS=true

# Enable debug logs for rate limiting
RATE_LIMIT_DEBUG_LOGS=false
