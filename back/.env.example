# Server
PORT=4000
ENABLE_SWAGGER=false

# Network and URLs
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database and cache
DATABASE_URL=postgresql://nexstore:nexstore@127.0.0.1:5432/nexstore?schema=public
REDIS_URL=redis://localhost:6379

# Auth and security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
EMAIL_MX_REQUIRED=true
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com,yopmail.com

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nexstore.local

# Commerce and payments
TAX_RATE=0.15
MP_ACCESS_TOKEN=replace-with-mercadopago-access-token
LOW_STOCK_ALERT_EMAIL=ops@nexstore.local

# Storage (MinIO local)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=nexstore-products
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/nexstore-products
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_FILE_SIZE_BYTES=5242880
