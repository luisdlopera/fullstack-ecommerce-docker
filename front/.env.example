# Browser-visible API URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side API URL for Next.js Route Handlers/BFF in local dev
# In Docker Compose this value is overridden to http://back:4000/api
INTERNAL_API_URL=http://localhost:4000/api

# Storage Base URL for serving assets from R2, MinIO, or CDN
# Leave empty for local development (uses /public folder paths)
# Set to your R2 public URL or custom domain for production
# Examples:
#   R2 with r2.dev: https://your-bucket.r2.dev
#   Custom domain:  https://img.tudominio.com
NEXT_PUBLIC_STORAGE_BASE_URL=https://pub-e14c4ed4e514428faeb13ca8f02c15a7.r2.dev
