{
	"name": "nexstore-front",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": "22"
	},
	"scripts": {
		"dev": "next dev -p ${FRONTEND_PORT:-${FRONT_PORT:-5006}}",
		"build": "next build",
		"start": "next start -p ${FRONTEND_PORT:-${FRONT_PORT:-5006}}",
		"test": "vitest run",
		"test:e2e": "playwright test --config playwright.config.mjs",
		"test:e2e:auth:real": "E2E_AUTH_REAL=1 playwright test --config playwright.auth-real.config.mjs e2e/account-authenticated.spec.ts",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write .",
		"eslint:format": "eslint --fix .",
		"prettier:format": "prettier --write .",
		"prettier:check": "prettier --check ."
	},
	"dependencies": {
		"@fontsource/urbanist": "^5.2.7",
		"@heroui/react": "^2.6.14",
		"@heroui/system": "^2.4.27",
		"@heroui/theme": "^2.4.26",
		"@hookform/resolvers": "^5.4.0",
		"@nexstore/api-types": "*",
		"@tanstack/react-query": "^5.101.2",
		"framer-motion": "^12.42.2",
		"lucide-react": "^0.577.0",
		"next": "16.2.10",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.81.0",
		"react-hot-toast": "^2.6.0",
		"swiper": "^12.1.4",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@types/node": "^20.19.43",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.10",
		"jsdom": "^26.0.0",
		"postcss": "^8",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4",
		"typescript": "^5.7.3",
		"vitest": "^3.0.5"
	}
}
